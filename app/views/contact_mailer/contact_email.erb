<h2>New Contact Form Submission</h2>

<p><strong>Name:</strong> <%= sanitize(@name, tags: []) %></p>
<p><strong>Email:</strong> <%= sanitize(@email, tags: []) %></p>
<p><strong>Subject:</strong> <%= sanitize(@subject, tags: []) %></p>

<p><strong>Message:</strong></p>
<pre style="font-family: sans-serif; white-space: pre-wrap; word-wrap: break-word;"><%= sanitize(@message, tags: []) %></pre>

<hr>
<p><em>This message was sent from the contact form on your website.</em></p>
