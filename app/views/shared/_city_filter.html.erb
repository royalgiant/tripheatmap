<div class="mb-4">
  <div class="relative">
    <input
      type="text"
      id="homepage-city-filter-input"
      placeholder="Filter cities by name..."
      class="w-full px-4 py-4 pl-12 bg-white border border-gray-300 rounded-lg text-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
    />
    <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </div>
</div>

<script>
  $(document).ready(function() {
    const $filterInput = $('#homepage-city-filter-input');
    const $allCityLinks = $('.city-guide-link');

    function normalizeText(text) {
      return text.toLowerCase().trim();
    }

    $filterInput.on('keyup', function() {
      const filterText = normalizeText($(this).val());

      $allCityLinks.hide();
      $('.country-section').hide();
      $('.continent-section').hide();

      if (filterText === '') {
        $allCityLinks.show();
        
        $('.country-section').each(function() {
          const countryId = $(this).attr('id');
          const isUs = $(this).hasClass('is-us');
          const $countryContent = $(this).find('.cities-container');
          
          $(this).show();
          $(this).find('.country-toggle-button').show();
          $(this).closest('.continent-section').show();

          if (isUs) {
            $countryContent.removeClass('hidden');
            $(this).find('.country-toggle-icon').addClass('rotate-180');
          } else {
            $countryContent.addClass('hidden');
            $(this).find('.country-toggle-icon').removeClass('rotate-180');
          }
        });

        $('[id$="-more-btn"]').each(function() {
            const $btn = $(this);
            const countryId = $btn.attr('id').replace('-more-btn', '');
            const $moreContent = $('#' + countryId + '-more');
            const $moreText = $('#' + countryId + '-more-text');
            
            $btn.show();

            if (!$moreContent.hasClass('hidden')) {
                $moreContent.addClass('hidden');
                $moreText.text($moreText.data('original-text'));
            }
        });
        return;
      }

      $allCityLinks.each(function() {
        const cityName = normalizeText($(this).data('city-name'));
        if (cityName.includes(filterText)) {
          $(this).show();

          const $citiesContainer = $(this).closest('.cities-container');
          $citiesContainer.removeClass('hidden'); 
          const $parentHiddenContainer = $(this).closest('[id$="-more"]');
          if ($parentHiddenContainer.length) {
            $parentHiddenContainer.removeClass('hidden');
            const countryId = $parentHiddenContainer.attr('id').replace('-more', '');
            $('#' + countryId + '-more-btn').hide();
          }

          const $countrySection = $(this).closest('.country-section');
          $countrySection.show(); 
          $countrySection.find('.country-toggle-button').show();
          $countrySection.find('.country-toggle-icon').addClass('rotate-180'); 

          const $continentSection = $(this).closest('.continent-section');
          $continentSection.show(); 
        }
      });
    });
  });
</script>