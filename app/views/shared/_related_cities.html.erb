<% if related_cities.any? %>
  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-gray-900 mt-6 mb-3">More Cities in <%= country_name %></h2>
    <p class="text-gray-600">Explore neighborhood rankings in other <%= country_name %> cities</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <% related_cities.each do |related| %>
        <%= link_to related[:url], class: "rounded-xl border-2 border-gray-200 bg-white p-4 text-center hover:border-blue-500 hover:bg-blue-50 transition" do %>
          <p class="text-base font-semibold text-gray-900"><%= related[:city].titleize %></p>
          <p class="text-sm text-gray-600 mt-1">View rankings →</p>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
