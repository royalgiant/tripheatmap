<%= form_with(model: rental, url: form_url, method: form_method, local: true, class: "space-y-6") do |form| %>
  <% if rental.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4">
      <h3 class="text-sm font-medium text-red-800">
        <%= pluralize(rental.errors.count, "error") %> prohibited this rental from being saved:
      </h3>
      <ul class="mt-2 list-disc list-inside text-sm text-red-700">
        <% rental.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label for="rental_type" class="block text-sm font-medium text-gray-700 mb-2">Rental Type</label>
    <%= select_tag 'place[rental_type]',
        options_for_select([['Airbnb', 'airbnb'], ['VRBO', 'vrbo']], rental.place_type),
        id: "rental_type",
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 text-gray-900" %>
  </div>

  <div>
    <%= form.label :name, "Property Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :name, placeholder: "e.g., Cozy Downtown Loft",
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400", required: true %>
  </div>

  <div>
    <%= form.label :address, "Full Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :address, placeholder: "123 Main St, New York, NY 10001",
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400", required: true %>
    <% if local_assigns[:show_address_help] %>
      <p class="mt-2 text-sm text-gray-500">Enter the full address of your rental property</p>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :latitude, "Latitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :latitude, step: :any, placeholder: "40.7128",
          class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400", required: true %>
    </div>

    <div>
      <%= form.label :longitude, "Longitude", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :longitude, step: :any, placeholder: "-74.0060",
          class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400", required: true %>
    </div>
  </div>

  <% if local_assigns[:show_coordinates_help] %>
    <p class="text-sm text-gray-500">
      Need help finding coordinates? Use
      <a href="https://www.latlong.net/" target="_blank" class="text-blue-600 hover:text-blue-800 underline">LatLong.net</a>
      or right-click on Google Maps and select "What's here?"
    </p>
  <% end %>

  <div>
    <%= form.label :average_price, "Average Price ($/night)", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.number_field :average_price, step: :any, placeholder: "150",
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400" %>
    <p class="mt-1 text-sm text-gray-500">Optional: Average nightly rate in USD</p>
  </div>

  <div>
    <%= form.label :number_of_guests, "Number of Guests", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.number_field :number_of_guests, placeholder: "2", min: 1, max: 16,
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400" %>
    <p class="mt-1 text-sm text-gray-500">Optional: Maximum number of guests your property can accommodate. This is automatically populated for Airbnb listings.</p>
  </div>

  <div>
    <%= form.label :booking_url, "Booking URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.url_field :booking_url, placeholder: "https://www.airbnb.com/rooms/20727150",
        id: "booking_url_field",
        class: "block w-full px-4 py-3 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 placeholder-gray-400", required: true %>
    <p class="mt-1 text-sm text-gray-500">When you save, we'll automatically fetch the metadata for your listing for Airbnb. This is currently unavailable for VRBO due to VRBO import restrictions.</p>
  </div>

  <div class="flex gap-4">
    <%= form.submit submit_text, class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", rentals_path, class: "flex-1 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-lg transition-colors" %>
  </div>
<% end %>

<script>
$(document).ready(function() {
  const rentalTypeSelect = $('#rental_type');
  const bookingUrlField = $('#booking_url_field');

  function updateBookingUrlPlaceholder() {
    const rentalType = rentalTypeSelect.val();
    if (rentalType === 'vrbo') {
      bookingUrlField.attr('placeholder', 'https://www.vrbo.com/2950714');
    } else {
      bookingUrlField.attr('placeholder', 'https://www.airbnb.com/rooms/20727150');
    }
  }

  // Update on page load
  updateBookingUrlPlaceholder();

  // Update on change
  rentalTypeSelect.on('change', updateBookingUrlPlaceholder);
});
</script>
