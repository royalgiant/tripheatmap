<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white shadow rounded-lg p-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">Add Your Rental</h1>

      <p class="text-gray-600 mb-8">
        List your Airbnb or VRBO rental on TripHeatMap to reach travelers searching for vibrant neighborhoods.
      </p>

      <%= render 'form',
          rental: @rental,
          form_url: rentals_path,
          form_method: :post,
          submit_text: "Add Rental",
          show_address_help: true,
          show_coordinates_help: true,
          show_booking_url_help: true %>
    </div>
  </div>
</div>
