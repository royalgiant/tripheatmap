<% content_for :head do %>
  <title><%= @seo_title %></title>
  <meta name="description" content="<%= @seo_description %>">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="<%= @seo_title %>">
  <meta property="og:description" content="<%= @seo_description %>">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @seo_title %>">
  <meta name="twitter:description" content="<%= @seo_description %>">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div>
    <% if @landmark.wikimedia_image? %>
      <div class="mb-6 rounded-lg overflow-hidden shadow-md">
        <%= image_tag @landmark.wikimedia_image_url(width: 800),
          alt: @landmark.name,
          class: "w-full h-auto object-cover max-h-96",
          loading: "lazy",
          onerror: "this.style.display='none'" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      <%= @hotels.count %> Hotels near <%= @landmark.name %> in <%= @city_display_name %>
    </h1>
    <p class="text-xl text-gray-600 mb-4">
      Find the best hotels within walking distance of <%= @landmark.name %>.
    </p>
    <a href="<%= google_maps_url(@landmark) %>" target="_blank" rel="noopener" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none">
      <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Directions to <%= @landmark.name %>
    </a>
  </div>

  <% if @has_hotels %>
    <%= render 'shared/hotel_filters', hotels: @hotels %>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
      <p class="text-sm text-blue-700">
        <strong>Trip.com Tip:</strong> If not redirected directly to the property, backspace a few characters in Trip.com's prefilled search box to populate the property you're looking for.
      </p>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200" id="hotel-list">
        <% @hotels.each do |hotel| %>
          <%= render 'shared/hotel_list_item', hotel: hotel, city_display_name: @city_display_name, nearby_landmark_name: @landmark.name %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">🏨</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Hotels Found</h3>
      <p class="text-gray-600 max-w-md mx-auto">
        We couldn't find any hotels near <%= @landmark.name %> in <%= @city_display_name %> yet.
        Check back later as we update our data!
      </p>
      <%= link_to "View All Hotels in #{@city_display_name}", where_to_stay_path(@url_slug), class: "inline-block mt-6 text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
    </div>
  <% end %>
</div>
