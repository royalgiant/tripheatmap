<% content_for :head do %>
  <title><%= @seo_title %></title>
  <meta name="description" content="<%= @seo_description %>">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="<%= @seo_title %>">
  <meta property="og:description" content="<%= @seo_description %>">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @seo_title %>">
  <meta name="twitter:description" content="<%= @seo_description %>">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div>
    <% if @airport.wikimedia_image? %>
      <div class="mb-6 rounded-lg overflow-hidden shadow-md">
        <%= image_tag @airport.wikimedia_image_url(width: 800),
          alt: @airport.name,
          class: "w-full h-auto object-cover max-h-96",
          loading: "lazy",
          onerror: "this.style.display='none'" %>
      </div>
    <% end %>
  </div>

  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      <%= @hotels.count %> Hotels near <%= @airport.name %> in <%= @city_display_name %>
    </h1>
    <p class="text-xl text-gray-600 mb-4">
      Find the best hotels within short distance of <%= @airport.name %>.
    </p>
    <a href="<%= google_maps_url(@airport) %>" target="_blank" rel="noopener" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none">
      <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Directions to <%= @airport.name %>
    </a>
  </div>

  <% if @has_hotels %>
    <section aria-labelledby="filter-heading" class="grid items-center border-b border-gray-200 pb-6 mb-6">
      <h2 id="filter-heading" class="sr-only">Filters</h2>
      <div class="relative col-start-1 row-start-1 py-4">
        <div class="flex max-w-7xl space-x-6 text-sm">
          <div>
            <button type="button" id="filter-toggle" class="group flex items-center font-medium text-gray-700 hover:text-gray-900">
              <svg class="mr-2 h-5 w-5 flex-none text-gray-400 group-hover:text-gray-500" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 0 1 .628.74v2.288a2.25 2.25 0 0 1-.659 1.59l-4.682 4.683a2.25 2.25 0 0 0-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 0 1 8 18.25v-5.757a2.25 2.25 0 0 0-.659-1.591L2.659 6.22A2.25 2.25 0 0 1 2 4.629V2.34a.75.75 0 0 1 .628-.74Z" clip-rule="evenodd" />
              </svg>
              <span id="filter-count-text">Filters</span>
            </button>
          </div>
          <div class="pl-6 border-l border-gray-200">
            <button type="button" id="clear-filters" class="text-gray-500 hover:text-gray-900">Clear all</button>
          </div>
        </div>
      </div>

      <div id="filter-panel" class="hidden border-t border-gray-200 py-10">
        <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
          <!-- Price Filter -->
          <fieldset>
            <legend class="block font-medium text-gray-900">Price</legend>
            <div class="space-y-3 pt-6">
              <% ['$', '$$', '$$$', '$$$$'].each do |price| %>
                <div class="flex items-center">
                  <input id="price-<%= price.length %>" name="price[]" value="<%= price %>" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox">
                  <label for="price-<%= price.length %>" class="ml-3 text-sm text-gray-600"><%= price %></label>
                </div>
              <% end %>
            </div>
          </fieldset>

          <fieldset>
            <legend class="block font-medium text-gray-900">Rating</legend>
            <div class="space-y-3 pt-6">
              <% [['4.5', '4.5+ Stars'], ['4.0', '4.0+ Stars'], ['3.5', '3.5+ Stars'], ['3.0', '3.0+ Stars']].each do |rating_val, label| %>
                <div class="flex items-center">
                  <input id="rating-<%= rating_val %>" name="rating[]" value="<%= rating_val %>" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox">
                  <label for="rating-<%= rating_val %>" class="ml-3 text-sm text-gray-600"><%= label %></label>
                </div>
              <% end %>
            </div>
          </fieldset>

          <fieldset>
            <legend class="block font-medium text-gray-900">Neighborhood</legend>
            <div class="space-y-3 pt-6 max-h-60 overflow-y-auto">
              <% @hotels.map(&:neighborhood).uniq.sort_by(&:name).each do |hood| %>
                <div class="flex items-center">
                  <input id="hood-<%= hood.id %>" name="neighborhood[]" value="<%= hood.id %>" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox">
                  <label for="hood-<%= hood.id %>" class="ml-3 text-sm text-gray-600"><%= hood.name %></label>
                </div>
              <% end %>
            </div>
          </fieldset>
        </div>
      </div>
    </section>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
      <p class="text-sm text-blue-700">
        <strong>Trip.com Tip:</strong> If not redirected directly to the property, backspace a few characters in Trip.com's prefilled search box to populate the property you're looking for.
      </p>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200" id="hotel-list">
        <% @hotels.each do |hotel| %>
          <li
            class="hotel-item flex flex-col sm:flex-row gap-x-6 py-5 hover:bg-gray-50 transition duration-150 ease-in-out px-4 sm:px-6"
            data-price="<%= hotel.price_range %>"
            data-rating="<%= hotel.rating %>"
            data-neighborhood="<%= hotel.neighborhood&.id %>"
          >
            <div class="flex-auto min-w-0">
              <div class="flex items-baseline justify-between gap-x-4">
                <h3 class="text-lg font-bold text-gray-900 hover:text-blue-600 transition-colors">
                  <%= hotel.name %>
                </h3>

                <div class="hidden sm:flex items-center gap-x-2 flex-shrink-0">
                  <% if hotel.distance_meters.present? %>
                    <span class="inline-flex items-center rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-500/10">
                      <%= number_to_human(hotel.distance_meters, units: { unit: 'm', thousand: 'km' }, precision: 1, strip_insignificant_zeros: true) %> away
                    </span>
                  <% end %>
                  <% if hotel.price_range.present? %>
                    <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-500/10">
                      <%= hotel.price_range %>
                    </span>
                  <% end %>
                  <% if hotel.rating.present? %>
                    <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-bold text-green-700 ring-1 ring-inset ring-green-600/20">
                      <%= hotel.rating %> ★
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="mt-1 text-sm leading-5 text-gray-500">
                <div class="flex items-center gap-x-1 truncate">
                  <svg class="h-4 w-4 flex-none text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="font-medium text-gray-700">Near <%= @airport.name %></span>
                  <span class="hidden sm:inline text-gray-300">|</span>
                  <span><%= hotel.neighborhood&.name %>,</span>
                  <span><%= @city_display_name %></span>
                </div>
                <% if hotel.address.present? %>
                  <div class="mt-1 text-gray-500">Hotel Address: <%= hotel.address %></div>
                <% end %>
              </div>

              <div class="mt-2 flex sm:hidden items-center gap-x-2 flex-wrap">
                <% if hotel.distance_meters.present? %>
                  <span class="inline-flex items-center rounded-md bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-500/10">
                    <%= number_to_human(hotel.distance_meters, units: { unit: 'm', thousand: 'km' }, precision: 1, strip_insignificant_zeros: true) %> away
                  </span>
                <% end %>
                <% if hotel.price_range.present? %>
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-500/10"><%= hotel.price_range %></span>
                <% end %>
                <% if hotel.rating.present? %>
                  <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-bold text-green-700 ring-1 ring-inset ring-green-600/20"><%= hotel.rating %> ★</span>
                <% end %>
              </div>

              <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
                <%= render 'shared/affiliate_buttons', place: hotel %>

                <div class="flex gap-3 w-full sm:w-auto">
                  <a href="<%= google_maps_url(hotel) %>" target="_blank" rel="noopener" class="flex-1 sm:flex-none inline-flex justify-center items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none w-full sm:w-auto">
                    Directions
                  </a>

                  <% if hotel.agoda_metadata.present? %>
                    <%= link_to "More Details", place_path(hotel.slug), data: { turbo_frame: "place_details_modal" }, class: "flex-1 sm:flex-none inline-flex justify-center items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none w-full sm:w-auto" %>
                  <% end %>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">🏨</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Hotels Found</h3>
      <p class="text-gray-600 max-w-md mx-auto">
        We couldn't find any hotels near <%= @airport.name %> in <%= @city_display_name %> yet.
        Check back later as we update our data!
      </p>
      <%= link_to "View All Hotels in #{@city_display_name}", where_to_stay_path(@url_slug), class: "inline-block mt-6 text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
    </div>
  <% end %>
</div>

<script>
  $(document).ready(function() {
    $('#filter-toggle').click(function() {
      $('#filter-panel').toggleClass('hidden');
    });

    function filterHotels() {
      const selectedPrices = $('input[name="price[]"]:checked').map(function() { return this.value; }).get();
      const selectedRatings = $('input[name="rating[]"]:checked').map(function() { return parseFloat(this.value); }).get();
      const selectedNeighborhoods = $('input[name="neighborhood[]"]:checked').map(function() { return parseInt(this.value); }).get();

      const totalFilters = selectedPrices.length + selectedRatings.length + selectedNeighborhoods.length;
      if (totalFilters > 0) {
        $('#filter-count-text').text(`${totalFilters} Filters`);
        $('#clear-filters').removeClass('invisible');
      } else {
        $('#filter-count-text').text('Filters');
        $('#clear-filters').addClass('invisible');
      }

      $('.hotel-item').each(function() {
        const price = $(this).data('price');
        const rating = parseFloat($(this).data('rating'));
        const neighborhood = parseInt($(this).data('neighborhood'));

        const priceMatch = selectedPrices.length === 0 || selectedPrices.includes(price);
        const ratingMatch = selectedRatings.length === 0 || selectedRatings.some(minRating => rating >= minRating);
        const neighborhoodMatch = selectedNeighborhoods.length === 0 || selectedNeighborhoods.includes(neighborhood);

        if (priceMatch && ratingMatch && neighborhoodMatch) {
          $(this).show();
        } else {
          $(this).hide();
        }
      });
    }

    $('.filter-checkbox').change(filterHotels);

    $('#clear-filters').click(function() {
      $('.filter-checkbox').prop('checked', false);
      filterHotels();
    });

    // Initial state for clear button
    $('#clear-filters').addClass('invisible');
  });
</script>
