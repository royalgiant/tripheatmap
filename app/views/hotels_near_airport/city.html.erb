<% content_for :head do %>
  <title><%= @seo_title %></title>
  <meta name="description" content="<%= @seo_description %>">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="<%= @seo_title %>">
  <meta property="og:description" content="<%= @seo_description %>">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @seo_title %>">
  <meta name="twitter:description" content="<%= @seo_description %>">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="text-center mb-12">
    <p class="text-sm uppercase tracking-wide text-blue-600 font-semibold mb-2">Hotels Near Airports</p>
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      <%= @airports.count %> Major Airports in <%= @city_display_name %>
    </h1>
    <p class="text-xl text-gray-600">
      Find hotels near major international and domestic airports in <%= @city_display_name %>.
    </p>
  </div>

  <% if @airports.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200">
        <% @airports.each do |airport| %>
          <div class="px-4 py-5 sm:px-6 hover:bg-gray-50 transition duration-150 ease-in-out">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div class="flex items-start min-w-0 flex-1 gap-3">
                <%
                  landmark_emoji = '✈️'
                %>
                <% if airport.wikimedia_image? %>
                  <div class="landmark-image-container flex-shrink-0">
                    <div class="w-20 h-20 rounded-lg overflow-hidden bg-gray-100">
                      <%= image_tag airport.wikimedia_image_url(width: 200),
                        alt: airport.name,
                        class: "w-full h-full object-cover",
                        loading: "lazy",
                        onerror: "this.closest('.landmark-image-container').style.display='none'; this.closest('.landmark-image-container').nextElementSibling.style.display='block';" %>
                    </div>
                  </div>
                  <span class="flex-shrink-0 text-2xl" style="display: none;">
                    <%= landmark_emoji %>
                  </span>
                <% else %>
                  <span class="flex-shrink-0 text-2xl">
                    <%= landmark_emoji %>
                  </span>
                <% end %>
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-gray-900">
                    <%= airport.name %>
                  </h3>
                  <p class="mt-1 text-sm text-gray-500">
                    <%= airport.neighborhood&.name %> · Airport
                  </p>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 w-full md:w-auto">
                <a href="https://www.google.com/maps/search/?api=1&query=<%= airport.lat %>,<%= airport.lon %>" target="_blank" rel="noopener" class="inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none">
                  Get Direction
                </a>
                <%= link_to "Hotels Near #{airport.name}", hotels_near_airport_path(airport.slug, @city_slug), class: "inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none" %>
              </div>
            </div>
          </div>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">✈️</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Airports Found</h3>
      <p class="text-gray-600 max-w-md mx-auto">
        We couldn't find any airports in <%= @city_display_name %> yet.
        Check back later as we update our data!
      </p>
      <%= link_to "Browse All Cities", hotels_near_airport_index_path, class: "inline-block mt-6 text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
    </div>
  <% end %>

  <!-- Back to All Cities -->
  <div class="mt-8 text-center">
    <%= link_to hotels_near_airport_index_path, class: "inline-flex items-center text-blue-600 hover:text-blue-800 font-medium" do %>
      <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to All Cities
    <% end %>
  </div>
</div>
