<% content_for :head do %>
  <title><%= @seo_title %></title>
  <meta name="description" content="<%= @seo_description %>">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="<%= @seo_title %>">
  <meta property="og:description" content="<%= @seo_description %>">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @seo_title %>">
  <meta name="twitter:description" content="<%= @seo_description %>">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      Best Luxury Hotels in <%= @city_display_name %>
    </h1>
    <p class="text-xl text-gray-600">
      <% if @top_neighborhoods.any? %>
        Discover the most exclusive and highly-rated luxury hotels featuring top-rated stays in <%= @top_neighborhoods.join(' and ') %>.
      <% else %>
        Discover the most exclusive and highly-rated luxury hotels for an unforgettable stay.
      <% end %>
    </p>
  </div>

  <% if @has_hotels %>
    <div class="mb-8">
      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-3 mb-4 justify-center">
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-green-500 text-white border-2 border-green-500 hover:bg-green-600" data-place-type="hotel_under_100">
          Under $100
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-orange-500 text-white border-2 border-orange-500 hover:bg-orange-600" data-place-type="hotel_100_200">
          $100-$200
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-red-500 text-white border-2 border-red-500 hover:bg-red-600" data-place-type="hotel_200_plus">
          $200+
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-blue-500 text-white border-2 border-blue-500 hover:bg-blue-600" data-place-type="restaurant">
          Restaurants
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-green-500 text-white border-2 border-green-500 hover:bg-green-600" data-place-type="cafe">
          Cafes
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-purple-500 text-white border-2 border-purple-500 hover:bg-purple-600" data-place-type="bar">
          Bars
        </button>
      </div>

      <div class="relative w-full rounded-lg overflow-hidden shadow-lg border border-gray-200" style="height: 600px;">
        <div id="hotel-detail-map"
          data-mapbox-token="<%= @mapbox_token %>"
          data-places="<%= @all_map_places.to_json(only: [:id, :name, :place_type, :latitude, :longitude, :address, :trip_affiliate_url, :average_price]) %>"
          style="width: 100%; height: 100%;">
        </div>
      </div>
    </div>

    <%= render 'shared/hotel_filters', hotels: @luxury_hotels %>

    <div class="bg-gray-50 border-l-4 border-yellow-400 p-4 mb-6">
      <p class="text-xs text-gray-600">
        <strong>Pro Tip:</strong> If not redirected directly to the property, backspace a few characters in Trip.com's prefilled search box to populate the property you're looking for.
      </p>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200" id="hotel-list">
        <% @luxury_hotels.each do |hotel| %>
          <%= render 'shared/hotel_list_item', hotel: hotel, city_display_name: @city_display_name %>
        <% end %>

        <% if @has_more %>
          <%= turbo_frame_tag "hotels_page_#{@page + 1}", src: best_luxury_hotels_path(@url_slug, page: @page + 1, **@filter_params), loading: :lazy do %>
            <li class="flex justify-center py-8">
              <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
            </li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">🏨</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Luxury Hotels Found</h3>
      <p class="text-gray-600 max-w-md mx-auto">
        We couldn't find any hotels categorized as "luxury" in <%= @city_display_name %> yet.
        Check back later as we update our data!
      </p>
      <%= link_to "View All Neighborhoods in #{@city_display_name}", where_to_stay_path(@url_slug), class: "inline-block mt-6 text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
    </div>
  <% end %>

  <%= render partial: 'shared/related_cities', locals: { related_cities: @related_cities, country_name: @country } %>
</div>


