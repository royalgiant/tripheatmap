<% content_for :head do %>
  <title><%= @seo_title %></title>
  <meta name="description" content="<%= @seo_description %>">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="<%= @seo_title %>">
  <meta property="og:description" content="<%= @seo_description %>">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @seo_title %>">
  <meta name="twitter:description" content="<%= @seo_description %>">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      <%= @cheap_hotels.count %> Best Cheap Hotels in <%= @city_display_name %>
    </h1>
    <p class="text-xl text-gray-600">
      Discover the most affordable, budget-friendly, and highly-rated hotels across <%= @cheap_hotels.count %> hotels in <%= Neighborhood.for_city(@city_config['city'].downcase).count %> neighborhoods.
    </p>
  </div>

  <% if @has_hotels %>
    <div class="mb-8">
      <div class="flex flex-wrap gap-3 mb-4 justify-center">
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-orange-500 text-white border-2 border-orange-500 hover:bg-orange-600" data-place-type="hotel">
          Hotels
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-blue-500 text-white border-2 border-blue-500 hover:bg-blue-600" data-place-type="restaurant">
          Restaurants
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-green-500 text-white border-2 border-green-500 hover:bg-green-600" data-place-type="cafe">
          Cafes
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-purple-500 text-white border-2 border-purple-500 hover:bg-purple-600" data-place-type="bar">
          Bars
        </button>
      </div>

      <div class="relative w-full rounded-lg overflow-hidden shadow-lg border border-gray-200" style="height: 600px;">
        <div id="hotel-detail-map"
          data-mapbox-token="<%= @mapbox_token %>"
          data-places="<%= @all_map_places.to_json(only: [:id, :name, :place_type, :latitude, :longitude, :address, :trip_affiliate_url]) %>"
          style="width: 100%; height: 100%;">
        </div>
      </div>
    </div>

    <%= render 'shared/hotel_filters', hotels: @cheap_hotels %>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
      <p class="text-sm text-blue-700">
        <strong>Trip.com Tip:</strong> If not redirected directly to the property, backspace a few characters in Trip.com's prefilled search box to populate the property you're looking for.
      </p>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200" id="hotel-list">
        <% @cheap_hotels.each do |hotel| %>
          <%= render 'shared/hotel_list_item', hotel: hotel, city_display_name: @city_display_name %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">🏨</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Cheap Hotels Found</h3>
      <p class="text-gray-600 max-w-md mx-auto">
        We couldn't find any budget-friendly hotels in <%= @city_display_name %> yet.
        Check back later as we update our data!
      </p>
      <%= link_to "View All Neighborhoods in #{@city_display_name}", where_to_stay_path(@url_slug), class: "inline-block mt-6 text-blue-600 hover:text-blue-800 font-medium hover:underline" %>
    </div>
  <% end %>

  <!-- Related Cities -->
  <%= render partial: 'shared/related_cities', locals: { related_cities: @related_cities, country_name: @country } %>
</div>


