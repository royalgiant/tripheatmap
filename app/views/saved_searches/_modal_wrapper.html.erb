<%
  # Parameters:
  # - title: Modal title text
  # - icon: FontAwesome icon class (e.g., 'fa-bell', 'fa-exclamation-triangle')
  # - color: Header gradient color ('blue', 'yellow', 'green', etc.)
  # - max_width: Optional max width class (default: 'max-w-2xl')
  # - scrollable: Optional boolean for scrollable content (default: false)

  color ||= 'blue'
  max_width ||= 'max-w-3xl'
  scrollable ||= false

  gradient_classes = {
    'blue' => 'from-blue-500 to-blue-600',
    'yellow' => 'from-yellow-500 to-yellow-600',
    'green' => 'from-green-500 to-green-600',
    'red' => 'from-red-500 to-red-600'
  }

  gradient = gradient_classes[color] || gradient_classes['blue']
%>

<%= turbo_frame_tag "save_search_modal" do %>
  <div class="fixed inset-0 bg-opacity-30 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl <%= max_width %> w-full mx-4">
      <!-- Modal Header -->
      <div class="bg-gradient-to-r <%= gradient %> px-6 py-4 rounded-t-lg">
        <div class="flex justify-between items-center">
          <h2 class="text-2xl font-bold text-white flex items-center">
            <i class="fa-solid <%= icon %> mr-2"></i>
            <%= title %>
          </h2>
          <button type="button"
                  onclick="document.getElementById('save_search_modal').innerHTML = ''"
                  class="text-white hover:text-gray-200 cursor-pointer">
            <i class="fa-solid fa-times text-2xl"></i>
          </button>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="p-6">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
