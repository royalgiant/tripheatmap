<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2 flex items-center">
        <i class="fa-solid fa-bell mr-3 text-blue-600"></i>
        My Saved Searches
      </h1>
      <p class="text-gray-600">
        Manage your saved hotel searches. We'll notify you when we negotiate exclusive deals matching your criteria.
      </p>
    </div>

    <div id="flash"></div>

    <turbo-frame id="edit_search_modal"></turbo-frame>

    <% if @saved_searches.any? %>
      <!-- Saved Searches Table -->
      <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Location
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Filters
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Travel Dates
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Created
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @saved_searches.each do |saved_search| %>
              <%= render 'search_row', saved_search: saved_search %>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Info Box -->
      <div class="mt-6 bg-blue-50 border-l-4 border-blue-400 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <i class="fa-solid fa-info-circle text-blue-400 text-lg"></i>
          </div>
          <div class="ml-3">
            <p class="text-sm text-blue-700">
              <strong>How it works:</strong> We aggregate demand from travelers to negotiate exclusive group rates with hotels.
              When we secure a deal matching your criteria, you'll receive an email notification.
            </p>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white shadow-md rounded-lg border border-gray-200 p-12 text-center">
        <div class="text-6xl mb-4">
          <i class="fa-solid fa-bell-slash text-gray-300"></i>
        </div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">No Saved Searches Yet</h3>
        <p class="text-gray-600 max-w-md mx-auto mb-6">
          Start by browsing hotels and saving your search criteria. We'll notify you when we negotiate deals matching your preferences.
        </p>
        <%= link_to "Browse Hotels", root_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
