<%= turbo_frame_tag "edit_search_modal" do %>
  <div class="fixed inset-0 bg-opacity-30 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full mx-4">
      <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4 rounded-t-lg">
        <div class="flex justify-between items-center">
          <h2 class="text-2xl font-bold text-white flex items-center">
            <i class="fa-solid fa-edit mr-2"></i>
            Edit Saved Search
          </h2>
          <button type="button"
                  onclick="document.getElementById('edit_search_modal').innerHTML = ''"
                  class="text-white hover:text-gray-200 cursor-pointer">
            <i class="fa-solid fa-times text-2xl"></i>
          </button>
        </div>
      </div>

      <div class="p-6">
        <%= render 'form', saved_search: @saved_search %>
      </div>
    </div>
  </div>
<% end %>
