<%
  # Parameters:
  # - f: form builder object
  # - show_label: Optional boolean to show/hide "(Optional)" label (default: true)

  show_label = local_assigns.fetch(:show_label, true)
%>

<div class="grid grid-cols-2 gap-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-2">
      Check-in Date <% if show_label %><span class="text-gray-400">(Optional)</span><% end %>
    </label>
    <%= f.date_field :checkin_date,
        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        min: Date.today %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-2">
      Check-out Date <% if show_label %><span class="text-gray-400">(Optional)</span><% end %>
    </label>
    <%= f.date_field :checkout_date,
        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        min: Date.today + 1 %>
  </div>
</div>
