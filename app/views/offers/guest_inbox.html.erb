<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2 flex items-center">
        <i class="fa-solid fa-inbox mr-3 text-blue-600"></i>
        My Offers
      </h1>
      <p class="text-gray-600">
        Exclusive offers from hosts based on your saved searches. Book directly and save on commissions.
      </p>
    </div>

    <!-- Filters -->
    <div class="mb-6 flex gap-3">
      <%= link_to offers_path, class: "px-4 py-2 rounded-lg font-medium text-sm transition-colors #{params[:status].blank? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
        All Offers
      <% end %>
      <%= link_to offers_path(status: 'active'), class: "px-4 py-2 rounded-lg font-medium text-sm transition-colors #{params[:status] == 'active' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
        Active
      <% end %>
      <%= link_to offers_path(status: 'accepted'), class: "px-4 py-2 rounded-lg font-medium text-sm transition-colors #{params[:status] == 'accepted' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
        Accepted
      <% end %>
      <%= link_to offers_path(status: 'expired'), class: "px-4 py-2 rounded-lg font-medium text-sm transition-colors #{params[:status] == 'expired' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
        Expired
      <% end %>
    </div>

    <% if @offers.any? %>
      <!-- Offers grouped by SavedSearch -->
      <% @saved_searches.each do |search| %>
        <% search_offers = @offers.select { |o| o.saved_search_id == search.id } %>
        <% next if search_offers.empty? %>

        <div class="mb-8">
          <!-- Search Header -->
          <div class="bg-gray-50 border border-gray-200 rounded-t-lg p-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              <i class="fa-solid fa-search text-gray-600 mr-2"></i>
              <%= search.location.titleize %> • <%= search.date_range %>
            </h3>
            <div class="flex gap-4 text-sm text-gray-600">
              <span><i class="fa-solid fa-dollar-sign mr-1"></i>Up to $<%= search.max_price_cents / 100 %>/night</span>
              <% if search.min_rating %>
                <span><i class="fa-solid fa-star text-yellow-500 mr-1"></i><%= search.min_rating %>+ stars</span>
              <% end %>
              <% if search.number_of_guests %>
                <span><i class="fa-solid fa-user-group mr-1"></i><%= search.number_of_guests %> guests</span>
              <% end %>
            </div>
            <p class="text-xs text-gray-500 mt-2">
              <%= pluralize(search_offers.count, 'offer') %> received
            </p>
          </div>

          <!-- Offers List -->
          <div class="border-l border-r border-b border-gray-200 rounded-b-lg divide-y divide-gray-200">
            <% search_offers.each do |offer| %>
              <div class="bg-white p-6 hover:bg-gray-50 transition-colors">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2">
                      <h4 class="text-lg font-semibold text-gray-900"><%= offer.place.name %></h4>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= offer.status == 'accepted' ? 'bg-green-100 text-green-800' : offer.status == 'expired' ? 'bg-gray-100 text-gray-800' : 'bg-blue-100 text-blue-800' %>">
                        <%= offer.status.humanize %>
                      </span>
                    </div>

                    <p class="text-sm text-gray-600 mb-3"><%= offer.place.address %></p>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                      <div>
                        <p class="text-xs text-gray-500">Your Price</p>
                        <p class="text-lg font-bold text-green-600">$<%= offer.offered_price_cents / 100 %></p>
                        <p class="text-xs text-gray-600"><%= offer.discount_description %></p>
                      </div>
                      <% if offer.place.average_price %>
                        <div>
                          <p class="text-xs text-gray-500">Regular Price</p>
                          <p class="text-sm text-gray-600 line-through">$<%= offer.place.average_price %></p>
                          <p class="text-xs text-green-600">Save $<%= (offer.place.average_price - offer.offered_price_cents / 100.0).round %></p>
                        </div>
                      <% end %>
                      <% if offer.place.rating %>
                        <div>
                          <p class="text-xs text-gray-500">Rating</p>
                          <p class="text-sm text-gray-900">
                            <i class="fa-solid fa-star text-yellow-500"></i> <%= offer.place.rating %>
                            <% if offer.place.review_count %>
                              <span class="text-gray-500">(<%= offer.place.review_count %>)</span>
                            <% end %>
                          </p>
                        </div>
                      <% end %>
                      <div>
                        <p class="text-xs text-gray-500">Expires</p>
                        <p class="text-sm font-medium text-gray-900"><%= offer.time_remaining %></p>
                      </div>
                    </div>

                    <% if offer.perks.present? && offer.perks.any? %>
                      <div class="mb-3">
                        <p class="text-xs text-gray-500 mb-1">Special Perks:</p>
                        <div class="flex flex-wrap gap-2">
                          <% offer.perks.each do |perk| %>
                            <span class="inline-flex items-center px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded">
                              <i class="fa-solid fa-gift mr-1"></i> <%= perk %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <% if offer.personal_message.present? %>
                      <div class="p-3 bg-blue-50 border-l-4 border-blue-400 rounded text-sm text-gray-700 mb-3">
                        <p class="text-xs text-blue-600 font-semibold mb-1">Message from host:</p>
                        "<%= offer.personal_message %>"
                      </div>
                    <% end %>
                  </div>

                  <div class="ml-6">
                    <%= link_to offer_path(offer), class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors" do %>
                      View Offer
                      <i class="fa-solid fa-arrow-right ml-2"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="bg-white shadow-md rounded-lg border border-gray-200 p-12 text-center">
        <div class="text-6xl mb-4">
          <i class="fa-solid fa-inbox text-gray-300"></i>
        </div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">No Offers Yet</h3>
        <p class="text-gray-600 max-w-md mx-auto mb-6">
          Save your hotel searches and hosts will send you exclusive offers. You'll be notified daily at 9 PM.
        </p>
        <%= link_to "Browse Hotels", root_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors" %>
      </div>
    <% end %>

    <!-- Info Box -->
    <div class="mt-6 bg-blue-50 border-l-4 border-blue-400 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <i class="fa-solid fa-info-circle text-blue-400 text-lg"></i>
        </div>
        <div class="ml-3">
          <p class="text-sm text-blue-700">
            <strong>How it works:</strong> When you save a search, hosts with matching properties can send you exclusive offers.
            You receive a daily digest at 9 PM with all new offers. Book directly and avoid platform commissions!
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
