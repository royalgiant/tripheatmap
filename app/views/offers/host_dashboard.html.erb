<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2 flex items-center">
        <i class="fa-solid fa-handshake mr-3 text-blue-600"></i>
        Lead Marketplace
      </h1>
      <p class="text-gray-600">
        Connect with travelers looking for properties like yours. Send exclusive offers and close deals.
      </p>
    </div>

    <!-- Tabs -->
    <div class="border-b border-gray-200 mb-6">
      <nav class="-mb-px flex space-x-8">
        <a href="#leads" class="tab-link active border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
          Potential Leads
          <% if @can_see_leads %>
            <span class="ml-2 bg-blue-100 text-blue-600 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @leads.count %></span>
          <% end %>
        </a>
        <a href="#sent" class="tab-link border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
          Sent Offers
          <span class="ml-2 bg-gray-100 text-gray-600 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @sent_offers.count %></span>
        </a>
        <a href="#messages" class="tab-link border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
          Messages
          <span class="ml-2 bg-gray-100 text-gray-600 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @messages.count %></span>
        </a>
      </nav>
    </div>

    <!-- Tab Content -->
    <div id="leads-content" class="tab-content">
      <% if !@can_see_leads %>
        <!-- Blurred/Locked State for Lifetime Users -->
        <div class="bg-white shadow rounded-lg border border-gray-200 p-12 text-center">
          <div class="text-6xl mb-4">
            <i class="fa-solid fa-lock text-gray-300"></i>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Unlock Lead Details</h3>
          <p class="text-gray-600 max-w-2xl mx-auto mb-4">
            You have <%= @leads_count %> travelers actively searching for properties in your area!
          </p>
          <div class="bg-blue-50 border-l-4 border-blue-400 p-6 mb-6 text-left max-w-2xl mx-auto">
            <p class="text-sm text-blue-700 mb-4">
              <strong>Upgrade to Monthly or Annual to:</strong>
            </p>
            <ul class="text-sm text-blue-700 space-y-2">
              <li class="flex items-start">
                <i class="fa-solid fa-check text-green-600 mr-2 mt-1"></i>
                <span>See full search details (dates, budget, guest count)</span>
              </li>
              <li class="flex items-start">
                <i class="fa-solid fa-check text-green-600 mr-2 mt-1"></i>
                <span>Send exclusive offers with custom pricing</span>
              </li>
              <li class="flex items-start">
                <i class="fa-solid fa-check text-green-600 mr-2 mt-1"></i>
                <span>Message potential guests directly</span>
              </li>
              <li class="flex items-start">
                <i class="fa-solid fa-check text-green-600 mr-2 mt-1"></i>
                <span>Close deals before other hosts</span>
              </li>
            </ul>
          </div>
          <%= link_to "Upgrade Now - Starting at $XX/month", pricing_path, class: "inline-flex items-center px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors text-lg" %>
        </div>
      <% elsif @leads.any? %>
        <!-- Leads List -->
        <div class="space-y-4">
          <% @leads.each do |search| %>
            <div class="bg-white shadow rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <% if search.created_at > 24.hours.ago %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="fa-solid fa-fire mr-1"></i> NEW
                      </span>
                    <% end %>
                    <span class="text-sm text-gray-500"><%= time_ago_in_words(search.created_at) %> ago</span>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wide">Location</p>
                      <p class="text-sm font-semibold text-gray-900"><i class="fa-solid fa-location-dot text-blue-600 mr-1"></i> <%= search.location.titleize %></p>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wide">Budget</p>
                      <p class="text-sm font-semibold text-gray-900"><i class="fa-solid fa-dollar-sign text-green-600 mr-1"></i> Up to $<%= search.max_price_cents / 100 %>/night</p>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wide">Dates</p>
                      <p class="text-sm font-semibold text-gray-900"><i class="fa-solid fa-calendar text-purple-600 mr-1"></i> <%= search.date_range %></p>
                    </div>
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wide">Rating</p>
                      <p class="text-sm font-semibold text-gray-900"><i class="fa-solid fa-star text-yellow-500 mr-1"></i> <%= search.min_rating || "Any" %>+ stars</p>
                    </div>
                  </div>

                  <% existing_offer = Offer.find_by(place_id: @my_places.pluck(:id), saved_search_id: search.id) %>
                  <% if existing_offer %>
                    <div class="mt-4 flex items-center gap-2 text-sm text-gray-600">
                      <i class="fa-solid fa-check-circle text-green-600"></i>
                      <span>You sent an offer <%= time_ago_in_words(existing_offer.created_at) %> ago</span>
                      <span class="text-gray-400">•</span>
                      <span class="capitalize"><%= existing_offer.status.humanize %></span>
                    </div>
                  <% end %>
                </div>

                <div class="ml-6">
                  <% if existing_offer %>
                    <%= link_to offer_path(existing_offer), class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors text-sm" do %>
                      <i class="fa-solid fa-eye mr-2"></i> View Offer
                    <% end %>
                  <% else %>
                    <%= link_to new_offer_path(saved_search_id: search.id), class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors text-sm" do %>
                      <i class="fa-solid fa-paper-plane mr-2"></i> Send Offer
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="bg-white shadow rounded-lg border border-gray-200 p-12 text-center">
          <div class="text-6xl mb-4">
            <i class="fa-solid fa-users-slash text-gray-300"></i>
          </div>
          <h3 class="text-xl font-medium text-gray-900 mb-2">No Matching Leads Yet</h3>
          <p class="text-gray-600 max-w-md mx-auto">
            We'll notify you when travelers search for properties matching your criteria.
          </p>
        </div>
      <% end %>
    </div>

    <div id="sent-content" class="tab-content hidden">
      <% if @sent_offers.any? %>
        <div class="space-y-4">
          <% @sent_offers.group_by(&:status).each do |status, offers| %>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-3 capitalize"><%= status.humanize %> (<%= offers.count %>)</h3>
              <div class="space-y-3">
                <% offers.each do |offer| %>
                  <div class="bg-white shadow rounded-lg border border-gray-200 p-6">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center gap-2 mb-2">
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= offer.status == 'accepted' ? 'bg-green-100 text-green-800' : offer.status == 'expired' ? 'bg-gray-100 text-gray-800' : 'bg-blue-100 text-blue-800' %>">
                            <%= offer.status.humanize %>
                          </span>
                          <span class="text-sm text-gray-500"><%= offer.saved_search.location.titleize %></span>
                        </div>
                        <p class="text-sm text-gray-900"><strong>$<%= offer.offered_price_cents / 100 %>/night</strong> <%= "(#{offer.discount_description})" if offer.discount_value.present? %></p>
                        <p class="text-xs text-gray-500 mt-1">
                          <% if offer.status == 'viewed' %>
                            Viewed <%= time_ago_in_words(offer.viewed_at) %> ago
                          <% else %>
                            Sent <%= time_ago_in_words(offer.created_at) %> ago
                          <% end %>
                          • Expires <%= offer.time_remaining %>
                        </p>
                      </div>
                      <div class="flex gap-2">
                        <%= link_to offer_path(offer), class: "inline-flex items-center px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded text-sm" do %>
                          View
                        <% end %>
                        <% if offer.status.in?(['sent', 'viewed']) %>
                          <%= button_to offer_path(offer), method: :delete, data: { confirm: "Delete this offer? You can send a new one after." }, class: "inline-flex items-center px-3 py-2 bg-red-100 hover:bg-red-200 text-red-700 font-medium rounded text-sm" do %>
                            Delete
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                    <% if offer.personal_message.present? %>
                      <div class="mt-3 p-3 bg-gray-50 rounded text-sm text-gray-700">
                        "<%= offer.personal_message %>"
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white shadow rounded-lg border border-gray-200 p-12 text-center">
          <div class="text-6xl mb-4">
            <i class="fa-solid fa-envelope-open-text text-gray-300"></i>
          </div>
          <h3 class="text-xl font-medium text-gray-900 mb-2">No Sent Offers</h3>
          <p class="text-gray-600">Send your first offer to start connecting with travelers.</p>
        </div>
      <% end %>
    </div>

    <div id="messages-content" class="tab-content hidden">
      <div class="bg-white shadow rounded-lg border border-gray-200 p-12 text-center">
        <div class="text-6xl mb-4">
          <i class="fa-solid fa-comments text-gray-300"></i>
        </div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">Messages</h3>
        <p class="text-gray-600">Message functionality coming soon.</p>
      </div>
    </div>

    <!-- Info Box -->
    <div class="mt-8 bg-blue-50 border-l-4 border-blue-400 p-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <i class="fa-solid fa-info-circle text-blue-400 text-lg"></i>
        </div>
        <div class="ml-3">
          <p class="text-sm text-blue-700 mb-2">
            <strong>Note:</strong> You can replace the current offer by deleting the current one and sending a new one.
          </p>
          <p class="text-xs text-blue-600">
            Offers are batched and sent to guests daily at 9 PM to reduce email spam.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.querySelectorAll('.tab-link').forEach(link => {
  link.addEventListener('click', (e) => {
    e.preventDefault();
    const target = link.getAttribute('href').substring(1);

    // Update active tab
    document.querySelectorAll('.tab-link').forEach(l => {
      l.classList.remove('active', 'border-blue-500', 'text-blue-600');
      l.classList.add('border-transparent', 'text-gray-500');
    });
    link.classList.add('active', 'border-blue-500', 'text-blue-600');
    link.classList.remove('border-transparent', 'text-gray-500');

    // Show/hide content
    document.querySelectorAll('.tab-content').forEach(content => {
      content.classList.add('hidden');
    });
    document.getElementById(target + '-content').classList.remove('hidden');
  });
});
</script>
