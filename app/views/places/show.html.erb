<%= turbo_frame_tag "place_details_modal" do %>
  <div class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Background backdrop -->
    <div class="fixed inset-0 bg-black/20 transition-opacity"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        <!-- Modal panel -->
        <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl sm:p-6">
          <div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
            <%= link_to close_places_path, class: "rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
              <span class="sr-only">Close</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            <% end %>
          </div>

          <div class="w-full">
            <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
              <h3 class="text-2xl font-semibold leading-6 text-gray-900 mb-2" id="modal-title"><%= @place.name %></h3>
              
              <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-6">
                <% if @place.neighborhood %>
                  <span><%= @place.neighborhood.name %></span>
                  <span>&middot;</span>
                <% end %>
                <span><%= @place.city.try(:titleize) || @place.city %></span>
                <% if @place.address.present? %>
                  <span>&middot;</span>
                  <span><%= @place.address %></span>
                <% end %>
              </div>

              <% if @place.agoda_metadata.present? %>
                <!-- Photos Grid -->
                <% photos = (1..5).map { |i| @place.agoda_metadata["photo#{i}"] }.compact %>
                <% if photos.any? %>
                  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2 mb-6">
                    <% photos.each do |photo_url| %>
                      <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden relative group">
                        <img src="<%= photo_url %>" alt="<%= @place.name %>" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110">
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <!-- Overview -->
                <% if @place.agoda_metadata['overview'].present? %>
                  <div class="mt-4 text-sm text-gray-600 max-h-60 overflow-y-auto text-left prose prose-sm max-w-none">
                    <%= simple_format @place.agoda_metadata['overview'] %>
                  </div>
                <% end %>
              <% else %>
                  <p class="text-gray-500 italic mt-4">No additional details available.</p>
              <% end %>
            </div>
          </div>

          <div class="mt-5 sm:mt-6 flex gap-3 sm:flex-row-reverse border-t pt-4">
            <% if @place.booking_url.present? %>
              <a href="<%= @place.booking_url %>" target="_blank" rel="noopener" class="inline-flex w-full justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:ml-3 sm:w-auto">
                Check Availability & Book
              </a>
            <% end %>
            <%= link_to "Close", close_places_path, class: "mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto" %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>