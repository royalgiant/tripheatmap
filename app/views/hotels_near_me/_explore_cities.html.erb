<% if @other_cities.present? %>
  <div class="mt-12 bg-blue-50 border border-blue-200 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Explore Other Cities</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% @other_cities.each do |city| %>
        <%= link_to city.titleize, hotels_near_me_path(city: city.parameterize), class: "text-blue-600 hover:text-blue-800 hover:underline" %>
      <% end %>
    </div>
  </div>
<% end %>
