<table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  <!-- Header -->
  <tr>
    <td style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); padding: 40px 30px; text-align: center;">
      <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">
        Your Offer Was Accepted!
      </h1>
      <p style="margin: 10px 0 0 0; color: #dcfce7; font-size: 14px;">TripHeatMap</p>
    </td>
  </tr>

  <!-- Main Content -->
  <tr>
    <td style="background-color: #ffffff; padding: 40px 30px;">
      <h2 style="margin: 0 0 20px 0; color: #1f2937; font-size: 24px; font-weight: bold;">
        Congratulations! You Have a New Booking
      </h2>

      <p style="margin: 0 0 30px 0; color: #4b5563; font-size: 16px; line-height: 1.6;">
        Hi <%= @host.first_name.presence.titleize || @host.full_name&.split(' ')&.first.titleize || @host.email.split('@').first.titleize %>,
      </p>

      <p style="margin: 0 0 30px 0; color: #4b5563; font-size: 16px; line-height: 1.6;">
        Great news! Your exclusive offer for <strong><%= @place.name %></strong> has been accepted by a guest.
        They will complete the booking through <%= @place.place_type.titleize %> and you can expect their arrival soon.
      </p>

      <!-- Booking Details Card -->
      <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 30px 0;">
        <tr>
          <td style="background-color: #f0fdf4; border: 2px solid #86efac; border-radius: 8px; padding: 25px;">
            <h3 style="margin: 0 0 20px 0; color: #166534; font-size: 20px; font-weight: bold;">
              Booking Details
            </h3>

            <table border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5;">
                  <p style="margin: 0; color: #6b7280; font-size: 13px; text-transform: uppercase;">Your Property</p>
                  <p style="margin: 5px 0 0 0; color: #1f2937; font-size: 16px; font-weight: bold;"><%= @place.name %></p>
                  <% if @place.address %>
                    <p style="margin: 3px 0 0 0; color: #6b7280; font-size: 14px;"><%= @place.address %></p>
                  <% end %>
                </td>
              </tr>

              <tr>
                <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5;">
                  <p style="margin: 0; color: #6b7280; font-size: 13px; text-transform: uppercase;">Offered Price</p>
                  <p style="margin: 5px 0 0 0; color: #15803d; font-size: 24px; font-weight: bold;">
                    $<%= @offer.offered_price_cents / 100 %><span style="font-size: 14px; font-weight: normal;">/night</span>
                  </p>
                  <% if @offer.discount_value.present? %>
                    <p style="margin: 3px 0 0 0; color: #166534; font-size: 14px;"><%= @offer.discount_description %></p>
                  <% end %>
                </td>
              </tr>

              <tr>
                <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5;">
                  <p style="margin: 0; color: #6b7280; font-size: 13px; text-transform: uppercase;">Guest's Dates</p>
                  <p style="margin: 5px 0 0 0; color: #1f2937; font-size: 16px;"><%= @offer.saved_search.date_range %></p>
                </td>
              </tr>

              <% if @offer.saved_search.number_of_guests %>
                <tr>
                  <td style="padding: 10px 0; border-bottom: 1px solid #d1fae5;">
                    <p style="margin: 0; color: #6b7280; font-size: 13px; text-transform: uppercase;">Number of Guests</p>
                    <p style="margin: 5px 0 0 0; color: #1f2937; font-size: 16px;"><%= @offer.saved_search.number_of_guests %></p>
                  </td>
                </tr>
              <% end %>

              <% if @offer.perks.present? && @offer.perks.any? %>
                <tr>
                  <td style="padding: 10px 0;">
                    <p style="margin: 0; color: #6b7280; font-size: 13px; text-transform: uppercase;">Perks You Offered</p>
                    <table border="0" cellpadding="0" cellspacing="0" style="margin-top: 8px;">
                      <% @offer.perks.each do |perk| %>
                        <tr>
                          <td style="padding: 3px 0; color: #15803d; font-size: 14px;">
                            ✓ <%= perk %>
                          </td>
                        </tr>
                      <% end %>
                    </table>
                  </td>
                </tr>
              <% end %>
            </table>
          </td>
        </tr>
      </table>

      <!-- Next Steps -->
      <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 30px 0;">
        <tr>
          <td style="background-color: #eff6ff; border-left: 4px solid #3b82f6; padding: 20px; border-radius: 4px;">
            <h3 style="margin: 0 0 15px 0; color: #1e40af; font-size: 18px; font-weight: bold;">
              What Happens Next
            </h3>
            <ol style="margin: 0; padding-left: 20px; color: #1f2937; font-size: 14px; line-height: 1.8;">
              <li>The guest will complete payment through <%= @place.place_type.titleize %></li>
              <li>You'll receive a booking notification from <%= @place.place_type.titleize %></li>
              <li>Prepare your property for the guest's arrival</li>
              <li>Make sure to provide the perks you promised in the offer</li>
            </ol>
          </td>
        </tr>
      </table>

      <!-- CTA Button -->
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td align="center" style="padding: 20px 0;">
            <a href="<%= offer_url(@offer) %>" style="display: inline-block; background-color: #2563eb; color: #ffffff; font-size: 16px; font-weight: bold; text-decoration: none; padding: 16px 40px; border-radius: 8px;">
              View Booking Details
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background-color: #f9fafb; padding: 30px; text-align: center; border-top: 1px solid #e5e7eb;">
      <p style="margin: 0 0 10px 0; color: #6b7280; font-size: 14px;">
        Keep up the great hosting!
      </p>
      <p style="margin: 0; color: #9ca3af; font-size: 12px;">
        &copy; <%= Time.current.year %> TripHeatMap. All rights reserved.
      </p>
    </td>
  </tr>
</table>
