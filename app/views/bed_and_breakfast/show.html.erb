<% content_for :head do %>
  <title>Bed and Breakfast in <%= @city_display_name %><%= ", #{@state}" if @state %> | TripHeatMap</title>
  <meta name="description" content="Find the best bed and breakfasts in <%= @city_display_name %>. Compare prices, ratings, and availability for top-rated B&Bs.">
  <link rel="canonical" href="<%= @canonical_url %>">
  <meta property="og:title" content="Bed and Breakfast in <%= @city_display_name %><%= ", #{@state}" if @state %>">
  <meta property="og:description" content="Find the best bed and breakfasts in <%= @city_display_name %>. Compare prices, ratings, and availability for top-rated B&Bs.">
  <meta property="og:url" content="<%= @canonical_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Bed and Breakfast in <%= @city_display_name %><%= ", #{@state}" if @state %>">
  <meta name="twitter:description" content="Find the best bed and breakfasts in <%= @city_display_name %>. Compare prices, ratings, and availability for top-rated B&Bs.">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Bed and Breakfast in <%= @city_display_name %></h1>
    <p class="text-xl text-gray-600 mb-4">
      Discover cozy and charming bed and breakfasts (hostels, airbnbs, vrbos) in <%= @city_display_name %><%= ", #{@state}" if @state %>
    </p>
  </div>

  <% if @bed_and_breakfasts.any? %>
    <div class="mb-8">
      <div class="flex flex-wrap gap-3 mb-4 justify-center">
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-red-500 text-white border-2 border-red-500 hover:bg-red-600" data-place-type="airbnb">
          Airbnb
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-blue-700 text-white border-2 border-blue-700 hover:bg-blue-800" data-place-type="vrbo">
          VRBO
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-yellow-500 text-white border-2 border-yellow-500 hover:bg-yellow-600" data-place-type="hostel">
          Hostels
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-blue-500 text-white border-2 border-blue-500 hover:bg-blue-600" data-place-type="restaurant">
          Restaurants
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-green-500 text-white border-2 border-green-500 hover:bg-green-600" data-place-type="cafe">
          Cafes
        </button>
        <button class="hotel-map-filter px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 bg-purple-500 text-white border-2 border-purple-500 hover:bg-purple-600" data-place-type="bar">
          Bars
        </button>
      </div>

      <div class="relative w-full rounded-lg overflow-hidden shadow-lg border border-gray-200" style="height: 600px;">
        <div id="hotel-detail-map"
          data-mapbox-token="<%= @mapbox_token %>"
          data-places="<%= @all_map_places.to_json(only: [:id, :name, :place_type, :latitude, :longitude, :address, :trip_affiliate_url, :average_price]) %>"
          style="width: 100%; height: 100%;">
        </div>
      </div>
    </div>

    <%= render 'shared/hotel_filters', hotels: @bed_and_breakfasts %>

    <div class="bg-white shadow overflow-hidden sm:rounded-md border border-gray-200">
      <ul role="list" class="divide-y divide-gray-200" id="hotel-list">
        <% @bed_and_breakfasts.each do |bnb| %>
          <%= render 'shared/hotel_list_item', hotel: bnb, city_display_name: @city_display_name %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
      <div class="text-6xl mb-4">🏡</div>
      <h3 class="text-2xl font-medium text-gray-900 mb-2">No Bed and Breakfasts Found in <%= @city_display_name %></h3>
      <p class="text-gray-600 max-w-md mx-auto mb-6">
        We don't have B&B listings for <%= @city_display_name %> yet. Try browsing other cities or use our general search.
      </p>
      <div class="flex gap-4 justify-center">
        <%= link_to "Find B&Bs Near Me", bnb_near_me_index_path, class: "inline-block bg-blue-600 hover:bg-blue-700 text-white rounded-md px-6 py-3 text-sm font-medium transition-colors" %>
        <%= link_to "Browse All Cities", bed_and_breakfast_index_path, class: "inline-block bg-gray-600 hover:bg-gray-700 text-white rounded-md px-6 py-3 text-sm font-medium transition-colors" %>
      </div>
    </div>
  <% end %>

  <%= render 'bnb_near_me/explore_cities' %>
</div>
