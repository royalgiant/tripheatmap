<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2"><%= @neighborhood.name %></h1>
    <p class="text-gray-600 mb-4"><%= @neighborhood.city.titleize %></p>

    <% if @stats %>
      <div class="flex flex-wrap gap-2 md:gap-3 text-xs md:text-sm">
        <button
          id="filter-restaurant"
          data-place-type="restaurant"
          class="place-type-filter bg-blue-100 hover:bg-blue-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-blue-100 whitespace-nowrap"
        >
          <strong><%= @restaurants.count %></strong> Restaurants
        </button>
        <button
          id="filter-cafe"
          data-place-type="cafe"
          class="place-type-filter bg-green-100 hover:bg-green-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-green-100 whitespace-nowrap"
        >
          <strong><%= @cafes.count %></strong> Cafes
        </button>
        <button
          id="filter-bar"
          data-place-type="bar"
          class="place-type-filter bg-purple-100 hover:bg-purple-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-purple-100 whitespace-nowrap"
        >
          <strong><%= @bars.count %></strong> Bars
        </button>
        <button
          id="filter-hotel"
          data-place-type="hotel"
          class="place-type-filter bg-orange-100 hover:bg-orange-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-orange-100 whitespace-nowrap"
        >
          <strong><%= @hotels.count %></strong> Hotels
        </button>
        <button
          id="filter-hostel"
          data-place-type="hostel"
          class="place-type-filter bg-yellow-100 hover:bg-yellow-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-yellow-100 whitespace-nowrap"
        >
          <strong><%= @hostels.count %></strong> Hostels
        </button>
        <button
          id="filter-airbnb"
          data-place-type="airbnb"
          class="place-type-filter bg-red-100 hover:bg-red-200 px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-red-100 whitespace-nowrap"
        >
          <strong><%= @airbnb_count %></strong> Airbnb
        </button>
        <button
          id="filter-vrbo"
          data-place-type="vrbo"
          class="place-type-filter bg-blue-900 hover:bg-blue-800 text-white px-2 md:px-3 py-1 rounded cursor-pointer transition-all border-2 border-blue-900 whitespace-nowrap"
        >
          <strong><%= @vrbo_count %></strong> VRBO
        </button>
        <span class="bg-gray-100 px-2 md:px-3 py-1 rounded whitespace-nowrap">
          <strong>Vibrancy Score:</strong> <%= @stats.vibrancy_index.round(1) %>/10
        </span>
      </div>
    <% end %>
  </div>

  <!-- Two Column Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Left Column: Places List -->
    <div id="places-list" class="bg-white rounded-lg shadow p-6 overflow-y-auto" style="max-height: 800px; scroll-behavior: smooth;">
      <h2 class="text-2xl font-bold mb-4">Places</h2>

      <%= turbo_frame_tag "places_list", src: places_list_neighborhood_path(@neighborhood.slug), loading: :lazy do %>
        <div class="flex flex-col items-center justify-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mb-4"></div>
          <p class="text-gray-600">Loading places...</p>
        </div>
      <% end %>
    </div>

    <!-- Right Column: Map -->
    <div class="bg-white rounded-lg shadow">
      <div
        id="neighborhood-detail-map"
        class="w-full rounded-lg"
        style="height: 800px;"
        data-mapbox-token="<%= @mapbox_token %>"
        data-places="<%= @places.to_json(only: [:id, :name, :place_type, :latitude, :longitude, :address, :booking_url]) %>"
        data-neighborhood="<%= @neighborhood.to_json(only: [:id, :name, :city]) %>">
      </div>
    </div>
  </div>
</div>
