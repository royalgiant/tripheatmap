<li class="border-b pb-3 mb-3 transition-colors duration-500" id="place-<%= place.id %>">
  <div class="flex items-start justify-between gap-x-2">
    <div class="font-medium text-base flex-1 min-w-0">
      <a href="#" class="place-name-link hover:text-blue-600 cursor-pointer" data-place-id="<%= place.id %>">
        <%= place.name %>
      </a>
    </div>
    <%= render 'favorites/button', place: place %>
  </div>

  <!-- Airbnb/VRBO Image Carousel and Metadata -->
  <% if (place.place_type == 'airbnb' || place.place_type == 'vrbo') && place.airbnb_vrbo_metadata.present? %>
    <% metadata = place.airbnb_vrbo_metadata %>
    <% all_images = [metadata['main_image'], *metadata['images']].compact %>

    <% if all_images.any? %>
      <div class="mt-3 relative" data-carousel-id="place-item-<%= place.id %>">
        <div class="rounded-lg overflow-hidden bg-gray-100">
          <% all_images.each_with_index do |image_url, index| %>
            <img src="<%= image_url %>"
                 alt="<%= place.name %> - Image <%= index + 1 %>"
                 class="carousel-image w-full h-64 object-cover <%= index == 0 ? '' : 'hidden' %>"
                 data-carousel-index="<%= index %>">
          <% end %>
        </div>

        <% if all_images.length > 1 %>
          <button type="button"
                  class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg transition-all"
                  data-carousel-id="place-item-<%= place.id %>">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button type="button"
                  class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg transition-all"
                  data-carousel-id="place-item-<%= place.id %>">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
            <% all_images.each_with_index do |_, index| %>
              <div class="carousel-dot w-2 h-2 rounded-full transition-all <%= index == 0 ? 'bg-white' : 'bg-white/50' %>"
                   data-carousel-index="<%= index %>"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if metadata.present? %>
      <div class="mt-2 flex flex-wrap gap-2 text-xs">
        <% if metadata['guests'].present? %>
          <span class="inline-flex items-center bg-blue-50 text-blue-700 px-2 py-1 rounded">
            👥 <%= metadata['guests'] %> guests
          </span>
        <% end %>
        <% if metadata['bedrooms'].present? %>
          <span class="inline-flex items-center bg-purple-50 text-purple-700 px-2 py-1 rounded">
            🛏️ <%= metadata['bedrooms'] %> <%= metadata['bedrooms'] == 1 ? 'bedroom' : 'bedrooms' %>
          </span>
        <% end %>
        <% if metadata['beds'].present? %>
          <span class="inline-flex items-center bg-indigo-50 text-indigo-700 px-2 py-1 rounded">
            🛌 <%= metadata['beds'] %> <%= metadata['beds'] == 1 ? 'bed' : 'beds' %>
          </span>
        <% end %>
        <% if metadata['baths'].present? %>
          <span class="inline-flex items-center bg-teal-50 text-teal-700 px-2 py-1 rounded">
            🚿 <%= metadata['baths'] %> <%= metadata['baths'] == 1 ? 'bath' : 'baths' %>
          </span>
        <% end %>
      </div>

      <% if metadata['amenities'].present? && metadata['amenities'].any? %>
        <div class="mt-2 text-xs text-gray-600">
          <span class="font-medium">Amenities:</span>
          <%= metadata['amenities'].take(5).join(', ') %><%= metadata['amenities'].length > 5 ? '...' : '' %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <!-- Rating and Price Range -->
  <div class="flex items-center mt-1 text-sm">
    <% rating_to_display = place.rating || (place.airbnb_vrbo_metadata&.dig('rating')) %>
    <% review_count = place.review_count || (place.airbnb_vrbo_metadata&.dig('review_count')) %>

    <% if rating_to_display.present? %>
      <div class="mr-2">
        <%= star_rating(rating_to_display) %>
      </div>
      <span class="text-gray-600 mr-2">
        <%= number_with_precision(rating_to_display, precision: 1) %>
        <% if review_count.present? %>
          (<%= review_count %>)
        <% end %>
      </span>
    <% end %>
    <% if place.price_range.present? || place.average_price.present? %>
      <span class="text-gray-700">
        <%= place.price_range || "$#{place.average_price}/night" %>
      </span>
    <% end %>
  </div>

  <!-- Address -->
  <% if place.address.present? %>
    <div class="text-sm text-gray-600 mt-1"><%= place.address %></div>
  <% end %>

  <!-- Additional Info -->
  <div class="mt-2 space-y-1 text-xs">
    <!-- Cuisine -->
    <% if place.tags['cuisine'].present? %>
      <div class="inline-block bg-gray-100 px-2 py-0.5 rounded mr-2">
        <span class="text-gray-700">🍴 <%= place.tags['cuisine'].titleize %></span>
      </div>
    <% end %>

    <!-- Delivery/Takeaway -->
    <% if place.tags['delivery'] == 'yes' || place.tags['takeaway'] == 'yes' %>
      <div class="inline-block bg-green-50 px-2 py-0.5 rounded mr-2">
        <% if place.tags['delivery'] == 'yes' && place.tags['takeaway'] == 'yes' %>
          <span class="text-green-700">🚗 Delivery & Takeaway</span>
        <% elsif place.tags['delivery'] == 'yes' %>
          <span class="text-green-700">🚗 Delivery</span>
        <% else %>
          <span class="text-green-700">🥡 Takeaway</span>
        <% end %>
      </div>
    <% end %>

    <!-- Phone -->
    <% if place.tags['phone'].present? %>
      <div class="text-gray-600 mt-1">
        📞 <a href="tel:<%= place.tags['phone'] %>" class="hover:underline"><%= place.tags['phone'] %></a>
      </div>
    <% end %>

    <!-- Website -->
    <% if place.tags['website'].present? %>
      <div class="text-gray-600 mt-1">
        🌐 <a href="<%= place.tags['website'] %>" target="_blank" rel="noopener" class="hover:underline text-blue-600">Website</a>
      </div>
    <% end %>

    <!-- Opening Hours -->
    <% if place.tags['opening_hours'].present? && place.tags['scope'] != 'GOOGLE' %>
      <div class="text-gray-600 mt-1">
        🕒 <%= place.tags['opening_hours'] %>
      </div>
    <% end %>

    <div class="mt-3 pt-2 border-t border-gray-100 flex flex-wrap gap-3">
      <a
        href="<%= google_maps_url(place) %>"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium rounded transition-colors">
        <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        Directions
      </a>

      <% if place.place_type == 'hotel' || place.place_type == 'hostel' %>
        <%= render 'shared/affiliate_buttons', place: place %>
        <% if place.booking_url.present? %>
          <a
            href="<%= place.booking_url %>"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center text-green-600 hover:text-green-800 font-medium text-xs">
            Official Site
          </a>
        <% end %>
      <% end %>
    </div>
  </div>
</li>
